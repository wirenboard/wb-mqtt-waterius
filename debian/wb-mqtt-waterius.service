[Unit]
Description=Send Wiren Board meter readings to Waterius
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/wb-mqtt-waterius daemon
Restart=on-failure
RestartSec=1
TimeoutStopSec=30
# A config error exits 6, bad arguments or a rejected MQTT login exit 2: stop
# cleanly instead of crash-looping. Saving a fixed config in the web UI makes
# confed restart the service. No devices configured exits 7: nothing to do.
RestartPreventExitStatus=2 6
SuccessExitStatus=7

[Install]
WantedBy=multi-user.target
